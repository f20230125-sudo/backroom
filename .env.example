# Copy to .env (gitignored) and fill in. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# rpm,tpm,rpd,tpd from your AI Studio rate-limit page (defaults stay below the free tier)
# GEMINI_LIMITS=10,200000,600,3000000

# Postgres (local or Neon unpooled URL for migrations). Empty = SQLite in .local/backroom.sqlite
DATABASE_URL=
# Shared secret for POST /api/hooks/inbox (HMAC-SHA256)
INBOX_WEBHOOK_SECRET=
